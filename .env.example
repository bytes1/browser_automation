# Qloo credentials are read by the Trigger.dev workflow worker.
QLOO_API_KEY=
# Optional. Defaults to the Qloo hackathon API.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Email provider credentials are configured in the Trigger.dev environment.
RESEND_API_KEY=
# Optional: use an address on a domain verified in Resend.
RESEND_FROM_EMAIL=

# Optional Gmail SMTP provider. The Google account must have 2-Step Verification enabled.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Only needed if SMTP TLS is intercepted; add your trusted network CA PEM.
GMAIL_SMTP_CA_CERT=

# Gemini API key used by the AI Workflow Builder (server-side only).
GEMINI_API_KEY=
